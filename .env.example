# Postgres connection string (used both locally and on Vercel, which has no
# writable filesystem for SQLite). A free Neon project works well — see
# README "Setup". Get one from https://neon.tech or `npx prisma init` won't
# create it for you; provision it yourself and paste the connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Set to "true" to use the mock market-data provider (default when unset).
# Set to "false" once a real provider (see src/lib/providers) is wired up.
USE_MOCK_PROVIDER="true"

# Shared secret required by /api/refresh so the cron endpoint can't be
# triggered by anyone who finds the URL. Generate with `openssl rand -hex 32`.
CRON_SECRET="change-me"

# Assumed annual gold price growth rate (%) used for the "projected" YTM
# scenario shown in the UI. The user can override this per-request too.
DEFAULT_GOLD_GROWTH_RATE_PCT="8"

# Web Push (browser notifications when an alert rule fires — see Alerts
# page). Generate a pair with `npx web-push generate-vapid-keys`. The public
# key is safe to expose client-side (NEXT_PUBLIC_ prefix, both must match);
# the private key must stay secret. Notifications silently stay off if these
# are unset — nothing else in the app depends on them.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="change-me"
VAPID_PRIVATE_KEY="change-me"
VAPID_SUBJECT="mailto:you@example.com"
